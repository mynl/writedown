{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writedown",
  "identifier": "com.mynl.writedown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Writedown",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "visible": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "qmd"],
        "name": "Markdown / Quarto Document",
        "description": "Markdown or Quarto document",
        "role": "Editor"
      },
      {
        "ext": ["agg", "dec", "decl"],
        "name": "DecL Program",
        "description": "aggregate Dec Language program",
        "role": "Editor"
      },
      {
        "ext": ["bib"],
        "name": "BibTeX Bibliography",
        "description": "BibTeX bibliography database",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
